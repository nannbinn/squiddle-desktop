{
  "name": "squiddle",
  "productName": "Squiddle",
  "version": "0.3.0",
  "description": "Squiddle 星空鼓手",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node scripts/prepare.js",
    "build-web": "node scripts/build-web.js",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:zip": "electron-builder --win dir --x64 --publish never && node scripts/zip-win.js",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "three": "0.128.0"
  },
  "build": {
    "appId": "app.squiddle.desktop",
    "productName": "Squiddle",
    "copyright": "Squiddle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Squiddle-Setup-${version}.${ext}",
      "shortcutName": "Squiddle"
    },
    "portable": {
      "artifactName": "Squiddle-${version}-portable.${ext}"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Squiddle-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Squiddle-${version}-mac-${arch}.${ext}"
    }
  }
}
